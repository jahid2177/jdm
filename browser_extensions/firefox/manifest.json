{
  "manifest_version": 2,
  "name": "Download with JDM",
  "version": "0.4.0",
  "description": "Send selected HTTP(S) links to Jahid Download Manager for Windows.",
  "permissions": ["contextMenus", "nativeMessaging", "storage", "activeTab"],
  "background": {"scripts": ["background.js"]},
  "browser_action": {"default_title": "Download with JDM", "default_popup": "popup.html"},
  "browser_specific_settings": {"gecko": {"id": "jdm-bridge@jahidul.app"}}
}
